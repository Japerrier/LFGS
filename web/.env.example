# Copy to .env for local dev (gitignored). Points the signup wizard at the
# local registration Lambda wrapper — see infra/lambda/registration-handler.
# In production this is set as a build-time env var in the deploy workflow,
# pointing at the real API Gateway invoke URL instead.
PUBLIC_REGISTRATION_API_URL=http://localhost:8787/register

# Cloudflare's dedicated "always passes" Turnstile site key — works on any
# hostname (including localhost), unlike the real site key. In production
# this is set as a build-time env var in the deploy workflow
# (PUBLIC_TURNSTILE_SITE_KEY GitHub variable) to the real site key, which is
# locked to the lfgs.gg hostname and won't render here.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
