---
import Layout from '../layouts/Layout.astro';
import { teams } from '../data/teams';
import { externalLinks } from '../data/site';
import { forMarquee } from '../lib/marquee';

const quickLinks = [
  { label: 'Schedule', desc: 'Weekly match dates for both brackets', href: '/tournament/schedule', shape: 'rounded-sm' },
  { label: 'Teams', desc: 'Every roster competing this season', href: '/tournament/teams', shape: 'rounded-full' },
  { label: 'Bracket', desc: 'Double-elim semifinals & finals', href: '/tournament/bracket', shape: 'rotate-45' },
  { label: 'Rulebook', desc: 'Format, roles, and dispute process', href: '/tournament/rulebook', shape: 'clip-triangle' },
];

const carouselTeams = forMarquee(teams);
---

<Layout title="Home">
  <!-- HERO -->
  <section class="relative flex h-[560px] flex-col items-center justify-center overflow-hidden border-b border-gold/15 text-center">
    <div
      class="absolute inset-0 bg-cover bg-[center_30%] brightness-50"
      style="background-image:url('/images/hero-characters.png')"
    >
    </div>
    <div class="absolute inset-0 bg-linear-to-b from-bg/30 via-bg/55 to-bg" style="--tw-gradient-via-position:60%"></div>
    <div class="relative z-2 flex flex-col items-center gap-[22px] px-6">
      <div class="font-display text-[15px] font-semibold uppercase tracking-[4px] text-gold">Overwatch Community Tournament</div>
      <h1 class="font-display text-[76px] font-bold leading-[0.95] tracking-wide text-ink-bright text-shadow-[0_4px_30px_rgba(0,0,0,0.6)]">
        SEASON 8<br />REGISTRATION OPEN
      </h1>
      <p class="max-w-[560px] text-lg leading-relaxed text-muted-softer">
        Diamond &amp; Platinum brackets. Double-elimination playoffs. Every scrim, sign-up and result runs through our Discord.
      </p>
      <div class="mt-2 flex flex-wrap justify-center gap-4">
        <a
          href="/tournament/schedule"
          class="rounded-lg bg-linear-to-br from-gold-grad-from to-gold-grad-to px-[30px] py-[15px] font-display text-[17px] font-bold text-gold-ink shadow-[0_8px_24px_rgba(240,180,41,0.3)]"
        >
          View Registration
        </a>
        <a
          href="/tournament/rulebook"
          class="rounded-lg border-[1.5px] border-gold/50 px-[30px] py-[15px] font-display text-[17px] font-bold text-ink"
        >
          View Rulebook
        </a>
      </div>
    </div>
  </section>

  <!-- QUICK ACCESS -->
  <section class="mx-auto max-w-6xl px-8 py-16">
    <h2 class="mb-7 text-center font-display text-[28px] font-bold text-ink">Tournament Quick Access</h2>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {quickLinks.map((q) => (
        <a href={q.href} class="rounded-xl border border-gold/15 bg-bg-raised p-6 transition-colors hover:border-gold/40">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-[10px] bg-linear-to-br from-gold/20 to-gold/5">
            {q.shape === 'clip-triangle' ? (
              <div class="h-4 w-4 bg-gold [clip-path:polygon(50%_0,100%_100%,0_100%)]"></div>
            ) : (
              <div class:list={['h-4 w-4 bg-gold', q.shape]}></div>
            )}
          </div>
          <div class="mb-1.5 font-display text-[19px] font-bold text-ink">{q.label}</div>
          <div class="text-[13.5px] leading-snug text-muted">{q.desc}</div>
        </a>
      ))}
    </div>
  </section>

  <!-- TEAM LOGO CAROUSEL -->
  {teams.length > 0 && (
    <section class="overflow-hidden pb-16">
      <h2 class="mb-[22px] text-center font-display text-[15px] font-bold uppercase tracking-[2px] text-muted">Season 8 Teams</h2>
      <div class="relative [mask-image:linear-gradient(90deg,transparent,#000_8%,#000_92%,transparent)]">
        <div class="animate-marquee flex w-max gap-9">
          {carouselTeams.map((t, i) => (
            <a href={`/teams/${t.slug}`} class="flex w-22 shrink-0 flex-col items-center gap-2" key={`${t.id}-${i}`}>
              <div
                class="flex h-17 w-17 items-center justify-center rounded-[14px] font-display text-xl font-bold text-bg"
                style={`background:linear-gradient(135deg,${t.primaryColor},${t.secondaryColor})`}
              >
                {t.initials}
              </div>
              <div class="w-22 truncate text-center text-[11.5px] text-muted">{t.name}</div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- STATS STRIP -->
  <section class="border-y border-gold/12 bg-bg-strip px-8 py-11">
    <div class="mx-auto grid max-w-5xl grid-cols-2 gap-6 text-center sm:grid-cols-4">
      {[
        { value: '8', label: 'Seasons Run' },
        { value: '18', label: 'Teams in S7 Diamond' },
        { value: '2', label: 'Competitive Brackets' },
        { value: 'Bo3', label: 'Double-Elim Finals' },
      ].map((s) => (
        <div>
          <div class="font-display text-[42px] font-bold text-gold">{s.value}</div>
          <div class="text-[13px] uppercase tracking-wide text-muted">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- WATCH & FOLLOW -->
  <section class="mx-auto max-w-6xl px-8 py-18">
    <h2 class="mb-2 text-center font-display text-[28px] font-bold text-ink">Watch &amp; Follow</h2>
    <p class="mb-8 text-center text-[15px] text-muted">Matches stream live. VODs and montages go up after.</p>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <a
        href={externalLinks.twitch}
        target="_blank"
        rel="noopener noreferrer"
        class="block rounded-2xl border border-twitch/30 bg-linear-to-br from-twitch/14 to-bg-raised p-7"
      >
        <div class="mb-1.5 font-display text-xl font-bold text-ink">Watch Live on Twitch</div>
        <div class="mb-3.5 text-sm text-muted-soft">Every scrim night and playoff match, streamed live.</div>
        <div class="text-[13.5px] font-semibold text-twitch">twitch.tv/lookingforgoldscrims →</div>
      </a>
      <a
        href={externalLinks.youtube}
        target="_blank"
        rel="noopener noreferrer"
        class="block rounded-2xl border border-youtube/28 bg-linear-to-br from-youtube/12 to-bg-raised p-7"
      >
        <div class="mb-1.5 font-display text-xl font-bold text-ink">Catch Up on YouTube</div>
        <div class="mb-3.5 text-sm text-muted-soft">Full match VODs after they conclude, plus season montages.</div>
        <div class="text-[13.5px] font-semibold text-youtube">youtube.com/@lfgs7475 →</div>
      </a>
    </div>
  </section>
</Layout>
