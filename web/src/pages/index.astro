---
import Layout from '../layouts/Layout.astro';
import { teams, teamInitials } from '../data/teams';
import { externalLinks } from '../data/site';
import { CURRENT_LFGS_SEASON } from '../lib/season';

const quickLinks = [
  { label: 'Schedule', desc: 'Stay up to date with tournament deadlines', href: '/tournament/schedule', shape: 'rounded-sm' },
  { label: 'Teams', desc: 'Every roster competing this season', href: '/tournament/teams', shape: 'rounded-full' },
  { label: 'Matchups', desc: 'See who is facing off in the upcoming week', href: '/tournament/matchups', shape: 'clip-triangle' },
  { label: 'Standings', desc: 'Current tournament standings', href: '/tournament/standings', shape: 'rotate-45' },
];
---

<Layout title="Home">
  <!-- HERO -->
  <section class="relative flex h-[560px] flex-col items-center justify-center overflow-hidden border-b border-gold/15 text-center">
    <div
      class="absolute inset-0 bg-cover bg-[center_30%] brightness-50"
      style="background-image:url('/images/hero-characters-40.png')"
    >
    </div>
    <div class="absolute inset-0 bg-linear-to-b from-bg/30 via-bg/55 to-bg" style="--tw-gradient-via-position:60%"></div>
    <div class="relative z-2 flex flex-col items-center gap-[22px] px-6">
      <div class="font-display text-[15px] font-semibold uppercase tracking-[4px] text-gold">Overwatch Community Tournament</div>
      <h1 class="font-display text-[76px] font-bold leading-[0.95] tracking-wide text-ink-bright text-shadow-[0_4px_30px_rgba(0,0,0,0.6)]">
        SEASON 8<br />REGISTRATION OPEN
      </h1>
      <p class="max-w-[560px] text-lg leading-relaxed text-muted-softer">
        Emerald &amp; Diamond brackets. Single-elimination playoffs. Prize pool for top 3 teams in each bracket. Join our Discord for updates and announcements.
      </p>
      <div class="mt-2 flex flex-wrap justify-center gap-4">
        <a
          href="/tournament/register"
          class="rounded-lg bg-linear-to-br from-gold-grad-from to-gold-grad-to px-[30px] py-[15px] font-display text-[17px] font-bold text-gold-ink shadow-[0_8px_24px_rgba(240,180,41,0.3)]"
        >
          Registration
        </a>
      </div>
    </div>
  </section>

  <!-- QUICK ACCESS -->
  <section class="content-width mx-auto px-8 py-16">
    <h2 class="mb-7 text-center font-display text-[28px] font-bold text-ink">Tournament Quick Access</h2>
    <div class="grid grid-cols-1 gap-[24px] sm:grid-cols-2 lg:grid-cols-4">
      {quickLinks.map((q) => (
        <a href={q.href} class="rounded-xl border border-gold/15 bg-bg-raised p-[29px] transition-colors hover:border-gold/40">
          <div class="mb-[20px] flex h-[53px] w-[53px] items-center justify-center rounded-[12px] bg-linear-to-br from-gold/20 to-gold/5">
            {q.shape === 'clip-triangle' ? (
              <div class="h-[20px] w-[20px] bg-gold [clip-path:polygon(50%_0,100%_100%,0_100%)]"></div>
            ) : (
              <div class:list={['h-[20px] w-[20px] bg-gold', q.shape]}></div>
            )}
          </div>
          <div class="mb-[8px] font-display text-[23px] font-bold text-ink">{q.label}</div>
          <div class="text-[16.5px] leading-snug text-muted">{q.desc}</div>
        </a>
      ))}
    </div>
  </section>

  <!-- TEAM LOGO CAROUSEL -->
  {teams.length > 0 && (
    <section class="overflow-hidden pb-16">
      <h2 class="mb-7 text-center font-display text-[28px] font-bold text-ink">Season {CURRENT_LFGS_SEASON} Teams</h2>
      <div class="mx-auto w-[95%] px-8">
        <div class="relative" data-team-carousel>
          <div class="flex flex-nowrap justify-center gap-[54px]" data-team-track>
            {teams.map((t) => (
              <a href={`/teams/${t.slug}`} class="flex w-33 shrink-0 flex-col items-center gap-3">
                {t.logoKey ? (
                  <img src={`/media/${t.logoKey}`} alt={`${t.name} logo`} class="h-[102px] w-[102px] rounded-[21px] object-cover" />
                ) : (
                  <div class="flex h-[102px] w-[102px] items-center justify-center rounded-[21px] bg-linear-to-br from-gold-grad-from to-gold-grad-to font-display text-2xl font-bold text-gold-ink">
                    {teamInitials(t.name)}
                  </div>
                )}
                <div class="w-33 truncate text-center text-[17px] text-muted">{t.name}</div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <script>
    function setupTeamCarousel() {
      const wrapper = document.querySelector<HTMLElement>('[data-team-carousel]');
      const track = document.querySelector<HTMLElement>('[data-team-track]');
      if (!wrapper || !track) return;

      if (!track.dataset.baseCount) {
        track.dataset.baseCount = String(track.children.length);
      }
      const baseCount = Number(track.dataset.baseCount);

      // Reset to the single (non-duplicated) base set before measuring, so re-runs on
      // resize don't compound leftover clones from a previous marquee pass.
      while (track.children.length > baseCount) {
        track.removeChild(track.lastElementChild as ChildNode);
      }
      track.classList.remove('animate-marquee', 'w-max');
      track.classList.add('justify-center');
      wrapper.style.maskImage = '';
      wrapper.style.webkitMaskImage = '';

      const overflowing = track.scrollWidth > wrapper.clientWidth;

      if (overflowing) {
        // Duplicate the base set once so the 0% -> -50% loop is seamless.
        Array.from(track.children)
          .slice(0, baseCount)
          .forEach((el) => track.appendChild(el.cloneNode(true)));
        track.classList.remove('justify-center');
        track.classList.add('animate-marquee', 'w-max');
        // Edge fade only makes sense once content is actually scrolling past the bounds.
        const fade = 'linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent)';
        wrapper.style.maskImage = fade;
        wrapper.style.webkitMaskImage = fade;
      }
    }

    setupTeamCarousel();

    let resizeTimeout: ReturnType<typeof setTimeout> | undefined;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(setupTeamCarousel, 150);
    });
  </script>

  <!-- STATS STRIP -->
  <section class="border-y border-gold/12 bg-bg-strip px-8 py-11">
    <div class="content-width mx-auto grid grid-cols-1 gap-6 text-center sm:grid-cols-3">
      {[
        { value: '8', label: 'Seasons Ran' },
        { value: '5', label: 'Years of Service' },
        { value: '2700+', label: 'Members' },
      ].map((s) => (
        <div>
          <div class="font-display text-[42px] font-bold text-gold">{s.value}</div>
          <div class="text-[13px] uppercase tracking-wide text-muted">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- WATCH & FOLLOW -->
  <section class="content-width mx-auto px-8 py-18">
    <h2 class="mb-2 text-center font-display text-[28px] font-bold text-ink">Watch &amp; Follow</h2>
    <p class="mb-8 text-center text-[15px] text-muted">Matches stream live. VODs and montages go up after.</p>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <a
        href={externalLinks.twitch}
        target="_blank"
        rel="noopener noreferrer"
        class="block rounded-2xl border border-twitch/30 bg-linear-to-br from-twitch/14 to-bg-raised p-7"
      >
        <div class="mb-1.5 font-display text-xl font-bold text-ink">Watch Live on Twitch</div>
        <div class="mb-3.5 text-sm text-muted-soft">Every scrim night and playoff match, streamed live.</div>
        <div class="text-[13.5px] font-semibold text-twitch">twitch.tv/lookingforgoldscrims →</div>
      </a>
      <a
        href={externalLinks.youtube}
        target="_blank"
        rel="noopener noreferrer"
        class="block rounded-2xl border border-youtube/28 bg-linear-to-br from-youtube/12 to-bg-raised p-7"
      >
        <div class="mb-1.5 font-display text-xl font-bold text-ink">Catch Up on YouTube</div>
        <div class="mb-3.5 text-sm text-muted-soft">Full match VODs after they conclude, plus season montages.</div>
        <div class="text-[13.5px] font-semibold text-youtube">youtube.com/@lfgs7475 →</div>
      </a>
    </div>
  </section>
</Layout>
