---
import Layout from '../../layouts/Layout.astro';
import { hofSeasons, getHofSeason } from '../../data/site';
import { LATEST_COMPLETE_SEASON } from '../../lib/season';

export function getStaticPaths() {
  return hofSeasons.map((s) => ({ params: { season: String(s.season) } }));
}

const { season: seasonParam } = Astro.params;
const season = Number(seasonParam);
const active = getHofSeason(season)!;
const hasMultipleBrackets = new Set(active.podium.map((p) => p.bracket)).size > 1;
// "TBD Player" placeholders hold the All-Star slots while a season is still
// running. Once it's complete they'd never be filled in, so drop them: a
// bracket with no named All-Stars disappears, and so does the whole section
// if no one was named.
const allStars = season <= LATEST_COMPLETE_SEASON ?active.allStars.filter((as) => !as.name.startsWith('TBD')) : active.allStars;
const hasBracketAllStars = allStars.some((as) => as.bracket);

const badgeStyles: Record<string, string> = {
  '1st': 'bg-linear-to-br from-[#f7d774] to-[#c9962c]',
  '2nd': 'bg-linear-to-br from-[#d9d9df] to-[#8a8a95]',
  '3rd': 'bg-linear-to-br from-[#d99a5c] to-[#8a5a2c]',
};
---

<Layout title={`Hall of Fame — Season ${season}`}>
  <div class="content-width mx-auto px-8 pb-20 pt-10">
    <div class="mb-7">
      <div class="font-display text-sm font-semibold uppercase tracking-[3px] text-gold">LFGS History</div>
      <h1 class="font-display text-[38px] font-bold text-ink">Hall of Fame</h1>
    </div>

    <div class="mb-8 flex flex-wrap gap-1.5 border-b border-gold/15">
      {hofSeasons.map((s) => (
        <a
          href={`/hall-of-fame/${s.season}`}
          class:list={[
            '-mb-px px-[18px] py-3 font-display text-[15px] font-semibold',
            s.season === season ? 'border-b-2 border-gold text-ink' : 'border-b-2 border-transparent text-muted',
          ]}
        >
          Season {s.season}
        </a>
      ))}
    </div>

    {allStars.length > 0 && (
      <>
        <h2 class="mb-4 font-display text-xl font-bold text-ink">All-Stars</h2>
        {hasBracketAllStars ? (
          <div class="mb-9 grid grid-cols-1 gap-6 md:grid-cols-2">
            {(['Emerald', 'Diamond'] as const).map((bracket) => {
              const entries = allStars.filter((as) => as.bracket === bracket);
              if (entries.length === 0) return null;
              return (
                <div>
                  <div class="mb-3 flex items-center gap-2.5">
                    <img src={`/images/${bracket}.png`} alt={`${bracket} bracket`} class="h-6 w-6 object-contain" />
                    <div class="font-display text-sm font-bold uppercase tracking-[2px] text-ink">{bracket}</div>
                  </div>
                  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    {entries.map((as) => (
                      <div class="flex flex-col items-center gap-2.5 rounded-xl border border-gold/14 bg-bg-raised p-5 text-center">
                        {as.href ? (
                          <a href={as.href} class="font-display text-xl font-bold text-ink hover:text-gold">{as.name}</a>
                        ) : (
                          <div class="font-display text-xl font-bold text-ink">{as.name}</div>
                        )}
                        <div class="text-[11px] font-semibold uppercase tracking-wide text-gold">{as.category} All-Star</div>
                      </div>
                    ))}
                  </div>
                </div>
              );
            })}
          </div>
        ) : (
          <div class="mb-9 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {allStars.map((as) => (
              <div class="flex flex-col items-center gap-2.5 rounded-xl border border-gold/14 bg-bg-raised p-5 text-center">
                {as.href ? (
                  <a href={as.href} class="font-display text-xl font-bold text-ink hover:text-gold">{as.name}</a>
                ) : (
                  <div class="font-display text-xl font-bold text-ink">{as.name}</div>
                )}
                <div class="text-[11px] font-semibold uppercase tracking-wide text-gold">{as.category} All-Star</div>
              </div>
            ))}
          </div>
        )}
      </>
    )}

    <h2 class="mb-4 font-display text-xl font-bold text-ink">Podium</h2>
    {hasMultipleBrackets ? (
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {(['Emerald', 'Diamond'] as const).map((bracket) => {
          const entries = active.podium.filter((p) => p.bracket === bracket);
          if (entries.length === 0) return null;
          return (
            <div>
              <div class="mb-3 flex items-center gap-2.5">
                <img src={`/images/${bracket}.png`} alt={`${bracket} bracket`} class="h-6 w-6 object-contain" />
                <div class="font-display text-sm font-bold uppercase tracking-[2px] text-ink">{bracket}</div>
              </div>
              <div class="flex flex-col gap-3">
                {entries.map((p) => (
                  <div
                    class:list={[
                      'flex justify-between gap-5 rounded-[10px] border border-gold/12 bg-bg-raised px-6 py-[18px]',
                      p.players && p.players.length > 0 ? 'items-start' : 'items-center',
                    ]}
                  >
                    <div
                      class:list={['flex gap-5', p.players && p.players.length > 0 ? 'items-start' : 'items-center']}
                    >
                      <div
                        class:list={[
                          'flex h-13 w-13 shrink-0 items-center justify-center rounded-lg font-display text-[15px] font-bold text-gold-ink',
                          badgeStyles[p.place],
                        ]}
                      >
                        {p.place}
                      </div>
                      <div>
                        {p.href ? (
                          <a href={p.href} class="font-display text-[19px] font-bold text-ink hover:text-gold">{p.team}</a>
                        ) : (
                          <div class="font-display text-[19px] font-bold text-ink">{p.team}</div>
                        )}
                        {p.players && p.players.length > 0 && (
                          <div class="mt-3 flex flex-col gap-2">
                            {p.players.map((player) => (
                              <div class="flex flex-wrap items-center gap-2">
                                <div class="flex items-center gap-1">
                                  <span class="text-sm text-muted-softer">{player.name}</span>
                                  {player.captain && <span class="text-[13px] text-gold">★</span>}
                                </div>
                                <div class="flex gap-1.5">
                                  {player.roles.map((r) => (
                                    <span class="rounded-full bg-gold/10 px-2.5 py-[3px] text-[11px] font-semibold text-gold">{r}</span>
                                  ))}
                                </div>
                              </div>
                            ))}
                          </div>
                        )}
                      </div>
                    </div>
                    {p.logoKey &&
                      (p.href ? (
                        <a href={p.href} class="shrink-0" tabindex="-1" aria-hidden="true">
                          <img src={`/media/${p.logoKey}`} alt={`${p.team} logo`} class="h-46 w-46 rounded-lg object-cover" />
                        </a>
                      ) : (
                        <img src={`/media/${p.logoKey}`} alt={`${p.team} logo`} class="h-46 w-46 shrink-0 rounded-lg object-cover" />
                      ))}
                  </div>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    ) : (
      <div class="flex flex-col gap-3">
        {active.podium.map((p) => (
          <div
            class:list={[
              'flex justify-between gap-5 rounded-[10px] border border-gold/12 bg-bg-raised px-6 py-[18px]',
              p.players && p.players.length > 0 ? 'items-start' : 'items-center',
            ]}
          >
            <div class:list={['flex gap-5', p.players && p.players.length > 0 ? 'items-start' : 'items-center']}>
              <div
                class:list={[
                  'flex h-13 w-13 shrink-0 items-center justify-center rounded-lg font-display text-[15px] font-bold text-gold-ink',
                  badgeStyles[p.place],
                ]}
              >
                {p.place}
              </div>
              <div>
                {p.href ? (
                  <a href={p.href} class="font-display text-[19px] font-bold text-ink hover:text-gold">{p.team}</a>
                ) : (
                  <div class="font-display text-[19px] font-bold text-ink">{p.team}</div>
                )}
                {p.players && p.players.length > 0 && (
                  <div class="mt-3 flex flex-col gap-2">
                    {p.players.map((player) => (
                      <div class="flex flex-wrap items-center gap-2">
                        <div class="flex items-center gap-1">
                          <span class="text-sm text-muted-softer">{player.name}</span>
                          {player.captain && <span class="text-[13px] text-gold">★</span>}
                        </div>
                        <div class="flex gap-1.5">
                          {player.roles.map((r) => (
                            <span class="rounded-full bg-gold/10 px-2.5 py-[3px] text-[11px] font-semibold text-gold">{r}</span>
                          ))}
                        </div>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </div>
            {p.logoKey &&
              (p.href ? (
                <a href={p.href} class="shrink-0" tabindex="-1" aria-hidden="true">
                  <img src={`/media/${p.logoKey}`} alt={`${p.team} logo`} class="h-46 w-46 rounded-lg object-cover" />
                </a>
              ) : (
                <img src={`/media/${p.logoKey}`} alt={`${p.team} logo`} class="h-46 w-46 shrink-0 rounded-lg object-cover" />
              ))}
          </div>
        ))}
      </div>
    )}
  </div>
</Layout>

<script define:vars={{ season }}>
  // Remembered so the header's Hall of Fame link reopens this season. savedAt
  // lets the header expire it after 30 days; re-saving on every view makes
  // that a rolling window.
  try {
    localStorage.setItem('lfgs:hof-season', JSON.stringify({ season, savedAt: Date.now() }));
  } catch (e) {
    // Storage unavailable (private mode, blocked): the link falls back to the default.
  }
</script>
