---
import Layout from '../../layouts/Layout.astro';
import RegisterWizard from '../../components/RegisterWizard';
import { CURRENT_SEASON } from '../../lib/season';
---

<Layout title="Register">
  <div class="content-width mx-auto px-8 pb-20 pt-10">
    <div class="mb-10 text-center">
      <div class="mb-1.5 font-display text-sm font-semibold uppercase tracking-[3px] text-gold">
        Season {CURRENT_SEASON}
      </div>
      <h1 class="font-display text-[38px] font-bold text-ink">Register Your Team</h1>
      <p class="mx-auto mt-2.5 max-w-lg text-[15px] text-muted-soft">
        Register your team for the Season {CURRENT_SEASON} tournament. It only takes a few minutes to fill out the form. Your team will appear on the website once your registration is approved. Please make sure to read the rules and regulations before registering.
      </p>
    </div>

    <RegisterWizard client:load />
  </div>
</Layout>
