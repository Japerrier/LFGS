---
import Layout from '../../layouts/Layout.astro';
import RegisterWizard from '../../components/RegisterWizard';
import { CURRENT_LFGS_SEASON } from '../../lib/season';
---

<Layout title="Register">
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async></script>
  <div class="content-width mx-auto px-8 pb-20 pt-10">
    <div class="mb-10 text-center">
      <div class="mb-1.5 font-display text-sm font-semibold uppercase tracking-[3px] text-gold">
        Season {CURRENT_LFGS_SEASON}
      </div>
      <h1 class="font-display text-[38px] font-bold text-ink">Register Your Team</h1>
    </div>

    <RegisterWizard client:load />
  </div>
</Layout>
