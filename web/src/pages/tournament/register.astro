---
import Layout from '../../layouts/Layout.astro';
import RegisterWizard from '../../components/RegisterWizard';
import { CURRENT_LFGS_SEASON, REGISTRATION_OPEN } from '../../lib/season';
import { externalLinks } from '../../data/site';
---

<Layout title="Register">
  {REGISTRATION_OPEN && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async></script>
  )}
  <div class="content-width mx-auto px-8 pb-20 pt-10">
    {REGISTRATION_OPEN ? (
      <Fragment>
        <div class="mb-10 text-center">
          <div class="mb-1.5 font-display text-sm font-semibold uppercase tracking-[3px] text-gold">
            Season {CURRENT_LFGS_SEASON}
          </div>
          <h1 class="font-display text-[38px] font-bold text-ink">Register Your Team</h1>
        </div>

        <RegisterWizard client:load />
      </Fragment>
    ) : (
      <div class="mx-auto max-w-xl py-20 text-center">
        <div class="mb-1.5 font-display text-sm font-semibold uppercase tracking-[3px] text-gold">
          Season {CURRENT_LFGS_SEASON}
        </div>
        <h1 class="mb-4 font-display text-[38px] font-bold text-ink">Registration Closed</h1>
        <p class="text-[15px] leading-relaxed text-muted-soft">
          Team sign-ups for this season have closed.
        </p>
          <p class="text-[15px] leading-relaxed text-muted-soft">
          Join our{' '}
          <a href={externalLinks.discord} target="_blank" rel="noopener noreferrer" class="text-gold underline">
            Discord
          </a>{' '}
          to get announcements for future tournaments.
        </p>
      </div>
    )}
  </div>
</Layout>
