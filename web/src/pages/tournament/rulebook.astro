---
import Layout from '../../layouts/Layout.astro';
import TournamentNav from '../../components/TournamentNav.astro';
import { rulebookHighlights, prizePool, externalLinks } from '../../data/site';
---

<Layout title="Rulebook">
  <div class="content-width mx-auto px-8 pb-20 pt-10">
    <TournamentNav activeTab="rulebook" />

    <div class="grid grid-cols-1 items-start gap-5 lg:grid-cols-[1.3fr_1fr]">
      <div class="rounded-2xl border border-gold/16 bg-bg-raised p-8">
        <h2 class="mb-2 font-display text-2xl font-bold text-ink">Season 8 Rulebook</h2>
        <p class="mb-[22px] text-[14.5px] leading-relaxed text-muted-soft">
          Highlights below — the full document covers registration, map pool, tiebreakers, DCs and etiquette in
          detail.
        </p>
        <div class="mb-[26px] flex flex-col gap-[11px]">
          {rulebookHighlights.map((line) => (
            <div class="flex gap-2.5 text-sm text-muted-softer">
              <span class="text-gold">—</span> {line}
            </div>
          ))}
        </div>
        <a
          href={externalLinks.rulebookDoc}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block rounded-lg bg-linear-to-br from-gold-grad-from to-gold-grad-to px-6 py-3 font-display text-[15px] font-bold text-gold-ink"
        >
          View Full Rulebook →
        </a>
      </div>

      <div class="rounded-2xl border border-gold/16 bg-bg-raised p-7">
        <h3 class="mb-4 font-display text-base font-bold text-ink">Prize Pool</h3>
        <div class="flex flex-col gap-3">
          {prizePool.map((p) => (
            <>
              <div class="flex items-baseline justify-between">
                <span class="text-[13.5px] text-muted-softer">{p.place}</span>
                <span class="font-display text-lg font-bold text-ink">{p.amount}</span>
              </div>
              {p.note && <div class="-mt-1.5 text-[11.5px] text-muted">{p.note}</div>}
            </>
          ))}
        </div>
        <div class="mt-4 text-[11.5px] leading-snug text-faint">
          Per player on the team. Teams that forfeit during playoffs are not paid out.
        </div>
      </div>
    </div>
  </div>
</Layout>
