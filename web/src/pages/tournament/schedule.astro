---
import Layout from '../../layouts/Layout.astro';
import TournamentNav from '../../components/TournamentNav.astro';
import { keyDates } from '../../data/site';
import { nowInNewYork, phaseEndsAt, phaseStatus } from '../../lib/key-dates';

const GOLD = 'bg-gold text-bg';
const GRAY = 'bg-white/6 text-muted';

// Build-time snapshot of each pill. Dated rows are re-derived in the browser
// below, since the site is static and only rebuilds on data changes.
const buildNow = nowInNewYork();
const rows = keyDates.map((d, i) => {
  if (!d.activeAt) return { ...d, pillStatus: d.status ?? 'TBD', gold: Boolean(d.highlight) };
  const endsAt = phaseEndsAt(keyDates, i);
  const pillStatus = phaseStatus(d.activeAt, endsAt, buildNow);
  return { ...d, endsAt, pillStatus, gold: pillStatus === 'In Progress' };
});
---

<Layout title="Schedule">
  <div class="content-width mx-auto px-8 pb-20 pt-10">
    <TournamentNav activeTab="schedule" />

    <div class="mb-5 flex flex-col gap-2.5">
      {rows.map((d) => (
        <div class="flex flex-wrap items-center gap-5 rounded-[10px] border border-gold/12 bg-bg-raised px-[22px] py-4">
          <div class="w-[200px] shrink-0 font-display text-[17px] font-bold text-gold">{d.label}</div>
          <div class="w-[230px] shrink-0 text-sm text-muted-soft">{d.date}</div>
          <div class="min-w-[180px] flex-1 text-sm text-muted-softer">{d.desc}</div>
          <div
            class:list={['rounded-full px-3.5 py-1.5 font-display text-xs font-bold', d.gold ? GOLD : GRAY]}
            data-status-pill
            data-active-at={d.activeAt}
            data-ends-at={d.endsAt}
          >
            {d.pillStatus}
          </div>
        </div>
      ))}
    </div>
  </div>

  <script>
    import { nowInNewYork, phaseStatus } from '../../lib/key-dates';

    // Re-derives each dated phase against the visitor's actual "now" (in
    // America/New_York), so pills don't go stale between deploys.
    const GOLD = ['bg-gold', 'text-bg'];
    const GRAY = ['bg-white/6', 'text-muted'];

    const now = nowInNewYork();
    document.querySelectorAll<HTMLElement>('[data-status-pill]').forEach((pill) => {
      const { activeAt, endsAt } = pill.dataset;
      // Flag-driven rows (registration) have no date to compare.
      if (!activeAt) return;

      const status = phaseStatus(activeAt, endsAt, now);
      pill.textContent = status;
      pill.classList.remove(...GOLD, ...GRAY);
      pill.classList.add(...(status === 'In Progress' ? GOLD : GRAY));
    });
  </script>
</Layout>
