---
import Layout from '../../../layouts/Layout.astro';
import TournamentNav from '../../../components/TournamentNav.astro';
import { getTeamsByBracket } from '../../../data/teams';
import { BRACKETS, bracketFromSlug, bracketToSlug } from '../../../lib/brackets';

export function getStaticPaths() {
  return BRACKETS.map((b) => ({ params: { bracket: bracketToSlug(b) } }));
}

const { bracket: bracketSlug } = Astro.params;
const bracket = bracketFromSlug(bracketSlug!);
const bracketTeams = getTeamsByBracket(bracket);
---

<Layout title={`${bracket} Teams`}>
  <div class="mx-auto max-w-6xl px-8 pb-20 pt-10">
    <TournamentNav activeTab="teams" bracket={bracket} />

    {bracketTeams.length === 0 ? (
      <div class="rounded-xl border border-gold/12 bg-bg-raised p-8 text-center text-muted">
        No {bracket} teams have been approved yet. Check back once Season 8 registration closes.
      </div>
    ) : (
      <div class="grid grid-cols-1 gap-[18px] sm:grid-cols-2 lg:grid-cols-3">
        {bracketTeams.map((t) => (
          <a
            href={`/teams/${t.slug}`}
            class="flex flex-col gap-3.5 rounded-xl border border-gold/14 bg-bg-raised p-[22px]"
          >
            <div class="flex items-center gap-3.5">
              <div
                class="flex h-13 w-13 shrink-0 items-center justify-center rounded-[10px] font-display text-lg font-bold text-bg"
                style={`background:linear-gradient(135deg,${t.primaryColor},${t.secondaryColor})`}
              >
                {t.initials}
              </div>
              <div>
                <div class="font-display text-[19px] font-bold text-ink">{t.name}</div>
                <div class="text-[12.5px] text-muted">Seed #{t.seed}</div>
              </div>
            </div>
            <div class="flex justify-between border-t border-white/6 pt-3 text-[13px] text-muted-soft">
              <span>Record: {t.record}</span>
              <span>{t.players.length} players</span>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</Layout>
