---
import Layout from '../../../layouts/Layout.astro';
import TournamentNav from '../../../components/TournamentNav.astro';
import BracketRedirect from '../../../components/BracketRedirect.astro';
import { getTeamsByBracket, teamInitials } from '../../../data/teams';
import { BRACKETS, bracketFromSlug, bracketToSlug } from '../../../lib/brackets';
import { CURRENT_LFGS_SEASON } from '../../../lib/season';

export function getStaticPaths() {
  return [
    // No bracket in the URL (e.g. a homepage quick-access link) — redirect
    // client-side to whichever bracket the visitor last had selected.
    { params: { bracket: undefined } },
    ...BRACKETS.map((b) => ({ params: { bracket: bracketToSlug(b) } })),
  ];
}

const { bracket: bracketSlug } = Astro.params;
const bracket = bracketSlug ? bracketFromSlug(bracketSlug) : undefined;
const bracketTeams = bracket ? getTeamsByBracket(bracket) : [];
---

<Layout title={bracket ? `${bracket} Teams` : 'Teams'}>
  <div class="content-width mx-auto px-8 pb-20 pt-10">
    {!bracket ? (
      <BracketRedirect tab="teams" />
    ) : (
      <>
        <TournamentNav activeTab="teams" bracket={bracket} />

        {bracketTeams.length === 0 ? (
          <div class="rounded-xl border border-gold/12 bg-bg-raised p-8 text-center text-muted">
            No {bracket} teams have been approved yet. Check back once Season {CURRENT_LFGS_SEASON} registration closes.
          </div>
        ) : (
          <div class="grid grid-cols-1 gap-[18px] sm:grid-cols-2 lg:grid-cols-3">
            {bracketTeams.map((t) => (
              <a
                href={`/teams/${t.slug}`}
                class="flex items-center gap-3.5 rounded-xl border border-gold/14 bg-bg-raised p-[22px]"
              >
                {t.logoKey ? (
                  <img src={`/media/${t.logoKey}`} alt={`${t.name} logo`} class="h-24 w-24 shrink-0 rounded-2xl object-cover" />
                ) : (
                  <div class="flex h-24 w-24 shrink-0 items-center justify-center rounded-2xl bg-linear-to-br from-gold-grad-from to-gold-grad-to font-display text-2xl font-bold text-gold-ink">
                    {teamInitials(t.name)}
                  </div>
                )}
                <div class="font-display text-[19px] font-bold text-ink">{t.name}</div>
              </a>
            ))}
          </div>
        )}
      </>
    )}
  </div>
</Layout>
