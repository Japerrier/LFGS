---
import Layout from '../../../layouts/Layout.astro';
import TournamentNav from '../../../components/TournamentNav.astro';
import BracketRedirect from '../../../components/BracketRedirect.astro';
import StandingsTable from '../../../components/StandingsTable.astro';
import { BRACKETS, bracketFromSlug, bracketToSlug } from '../../../lib/brackets';
import { getMatchupsByBracket } from '../../../data/matchups';
import { computeStandings } from '../../../lib/standings';

export function getStaticPaths() {
  return [
    // No bracket in the URL (e.g. a homepage quick-access link) — redirect
    // client-side to whichever bracket the visitor last had selected.
    { params: { bracket: undefined } },
    ...BRACKETS.map((b) => ({ params: { bracket: bracketToSlug(b) } })),
  ];
}

const { bracket: bracketSlug } = Astro.params;
const bracket = bracketSlug ? bracketFromSlug(bracketSlug) : undefined;

// One table per bracket — Diamond's two round-robin groups are ranked together.
const { main: rows, removed: removedRows } = bracket
  ? computeStandings(getMatchupsByBracket(bracket))
  : { main: [], removed: [] };
const hasResults = [...rows, ...removedRows].some((r) => r.played > 0);
const hasTies = rows.some((r) => r.tied);
const hasEliminated = rows.some((r) => r.team.status === 'eliminated');

// The second table is titled for whichever of the two statuses are in it.
const hasWithdrawn = removedRows.some((r) => r.team.status === 'withdrawn');
const hasDisqualified = removedRows.some((r) => r.team.status === 'disqualified');
const removedHeading =
  hasWithdrawn && hasDisqualified ? 'Withdrawn & Disqualified Teams' : hasDisqualified ? 'Disqualified Teams' : 'Withdrawn Teams';
const removedNoun =
  hasWithdrawn && hasDisqualified ? 'Withdrawn and disqualified' : hasDisqualified ? 'Disqualified' : 'Withdrawn';
---

<Layout title={bracket ? `${bracket} Standings` : 'Standings'}>
  <div class="content-width mx-auto px-8 pb-20 pt-10">
    {!bracket ? (
      <BracketRedirect tab="standings" />
    ) : (
      <>
        <TournamentNav activeTab="standings" bracket={bracket} />

        {!hasResults ? (
          <div class="rounded-xl border border-gold/12 bg-bg-raised p-8 text-center">
            <div class="mb-2 font-display text-lg font-bold text-ink">Standings TBD</div>
            <div class="text-sm text-muted">
              Standings will be available after Week 1. Check back once the {bracket} regular season is underway.
            </div>
          </div>
        ) : (
          <div class="flex flex-col gap-6">
            <StandingsTable rows={rows} />
            {removedRows.length > 0 && (
              <div class="flex flex-col gap-3">
                <h2 class="font-display text-xl font-bold text-ink">{removedHeading}</h2>
                <StandingsTable rows={removedRows} unranked />
              </div>
            )}
            <div class="flex flex-col gap-1 text-[15px] text-muted">
              <div>W/L: match wins and losses. MW/ML: map wins and losses. MD: map differential (map wins minus map losses).</div>
              <div>
                Ranked by match wins, then map wins, map differential, and head-to-head — see the{' '}
                <a href="/rulebook#tiebreaker" class="text-gold hover:underline">rulebook</a>. A forfeit counts as a 3-0 win.
              </div>
              {hasEliminated && <div>Teams below the Eliminated line are out of the tournament but keep their place in the standings.</div>}
              {removedRows.length > 0 && (
                <div>{removedNoun} teams are listed separately with their records. Results against them still count for everyone else.</div>
              )}
              {hasTies && (
                <div><span class="text-gold">*</span> Level on every tiebreaker so far; staff settle these with a best-of-3.</div>
              )}
            </div>
          </div>
        )}
      </>
    )}
  </div>
</Layout>
