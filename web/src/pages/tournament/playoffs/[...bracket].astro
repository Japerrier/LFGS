---
import Layout from '../../../layouts/Layout.astro';
import TournamentNav from '../../../components/TournamentNav.astro';
import BracketRedirect from '../../../components/BracketRedirect.astro';
import { BRACKETS, bracketFromSlug, bracketToSlug } from '../../../lib/brackets';
import { getRegularSeasonMatchupsByBracket, getPlayoffMatchupsByBracket } from '../../../data/matchups';
import { teamInitials } from '../../../data/teams';
import type { Team } from '../../../data/types';
import { computeStandings } from '../../../lib/standings';
import { resolveScores } from '../../../lib/matchScore';
import { formatMatchTime } from '../../../lib/matchTime';

export function getStaticPaths() {
  return [
    // No bracket in the URL (e.g. a homepage quick-access link) — redirect
    // client-side to whichever bracket the visitor last had selected.
    { params: { bracket: undefined } },
    ...BRACKETS.map((b) => ({ params: { bracket: bracketToSlug(b) } })),
  ];
}

const { bracket: bracketSlug } = Astro.params;
const bracket = bracketSlug ? bracketFromSlug(bracketSlug) : undefined;

// One side of a playoff card: either a real team or a placeholder label.
interface Side {
  label: string;
  team?: Team;
  /** Regular-season seed, e.g. "3" or "T-5" when level on every tiebreaker. */
  seed?: string;
  score?: number;
  won?: boolean;
}

interface Matchup {
  a: Side;
  b: Side;
  matchTime?: string;
  grandFinal?: boolean;
}

interface Column {
  title: string;
  matchups: Matchup[];
  /** Replaces the cards with a pointer to the Matchups tab, for weeks played as normal matches. */
  matchupsLink?: string;
}

const tbd = (label = 'TBD'): Side => ({ label });

// Diamond: all 8 teams are ranked together after the regular season. Seeds 1
// and 2 get byes; seeds 3-6 play in on week 1; the two winners join them in a
// 4-team double-elimination bracket for weeks 2-5. Seeds 5 and 6 were level on
// every tiebreaker, so each was drawn against a team from the other group
// (3 vs 6, 4 vs 5) rather than a team they'd already played.
//
// Seeds come from the regular season alone, so team status (eliminated,
// withdrawn) is ignored: the play-in losers are knocked out but the seeds
// shown in the play-in must not shift because of it.
const standings =
  bracket === 'Diamond'
    ? computeStandings(getRegularSeasonMatchupsByBracket('Diamond'), { ignoreStatus: true }).main
    : [];
const seedByTeamId = new Map(standings.map((r) => [r.team.teamId, r.tied ? `T-${r.rank}` : String(r.rank)]));
const rankByTeamId = new Map(standings.map((r) => [r.team.teamId, r.rank]));

function side(team: Team, score?: number, opponentScore?: number, seeds = seedByTeamId): Side {
  return {
    label: team.name,
    team,
    seed: seeds.get(team.teamId),
    score,
    won: score !== undefined && opponentScore !== undefined && score > opponentScore,
  };
}

const playoffRows = bracket === 'Diamond' ? getPlayoffMatchupsByBracket('Diamond') : [];
const playInWeek = playoffRows.length > 0 ? Math.min(...playoffRows.map((m) => m.week)) : undefined;
const playInRows = playoffRows.filter((m) => m.week === playInWeek);

const seedNumber = (s: Side) => Number(s.seed?.replace('T-', '') ?? Infinity);

// Real matchups for one playoff week. team1 is the top team on each card and
// team2 the bottom, exactly as stored. Best seed first, so the higher seed's
// match leads the column.
function matchupsFromRows(rows: typeof playoffRows, seeds = seedByTeamId): Matchup[] {
  return rows
    .filter((m) => !m.byeWeek && m.team2)
    .map((m) => {
      const { team1Score, team2Score } = resolveScores(m);
      return {
        a: side(m.team1, team1Score, team2Score, seeds),
        b: side(m.team2!, team2Score, team1Score, seeds),
        matchTime: m.matchTime,
      };
    })
    .sort((x, y) => Math.min(seedNumber(x.a), seedNumber(x.b)) - Math.min(seedNumber(y.a), seedNumber(y.b)));
}

const playIn: Column = {
  title: 'Week 1 — Play-In',
  matchups: matchupsFromRows(playInRows),
};

// Playoff weeks keep counting on from the regular season, so the first round
// after the play-in is the week right after it.
const round2Rows = playInWeek === undefined ? [] : playoffRows.filter((m) => m.week === playInWeek + 1);
// The play-in losers are out, so after it the seeds are renumbered: a play-in
// winner takes the better (lower) seed of its match, whichever team that was.
// Anyone in week 2 who played the play-in necessarily won it, so this needs no
// elimination flags. Teams that had a bye keep their regular-season seed.
const postPlayInSeedByTeamId = new Map(seedByTeamId);
for (const m of playInRows) {
  if (m.byeWeek || !m.team2) continue;
  const better = String(Math.min(rankByTeamId.get(m.team1.teamId) ?? Infinity, rankByTeamId.get(m.team2.teamId) ?? Infinity));
  postPlayInSeedByTeamId.set(m.team1.teamId, better);
  postPlayInSeedByTeamId.set(m.team2.teamId, better);
}

const round2: Column = {
  title: 'Week 2',
  matchups: matchupsFromRows(round2Rows, postPlayInSeedByTeamId),
};

// From week 3 on, a team's place in the double-elimination bracket is set by
// its results, not its seed, so seeds aren't shown.
const noSeeds = new Map<string, string>();

// Week 3 pairs the week 2 winners (upper bracket final) and the week 2 losers
// (lower bracket). The upper bracket match leads the column.
const round3Rows = playInWeek === undefined ? [] : playoffRows.filter((m) => m.week === playInWeek + 2);
const round2Winners = new Set(
  matchupsFromRows(round2Rows, postPlayInSeedByTeamId).flatMap((m) =>
    [m.a, m.b].filter((s) => s.won && s.team).map((s) => s.team!.teamId),
  ),
);
const upperWins = (m: Matchup) => [m.a, m.b].filter((s) => s.team && round2Winners.has(s.team.teamId)).length;

const round3: Column = {
  title: 'Week 3',
  // With no seeds, matchupsFromRows keeps the stored order, and that order holds
  // until week 2 results decide which match is the upper bracket one.
  matchups: matchupsFromRows(round3Rows, noSeeds).sort((x, y) => upperWins(y) - upperWins(x)),
};

// Weeks 4 and 5 are a single match each.
const rowsForRound = (offset: number) =>
  playInWeek === undefined ? [] : playoffRows.filter((m) => m.week === playInWeek + offset);
const round4Rows = rowsForRound(3);
const round5Rows = rowsForRound(4);

// The upper bracket final's winner goes straight to the Grand Final, so they
// can be shown there before the week 5 row exists. Their opponent waits on the
// lower bracket final.
const upperFinal = round3.matchups.find((m) => upperWins(m) === 2);
const upperFinalWinner = upperFinal && [upperFinal.a, upperFinal.b].find((s) => s.won && s.team);
const grandFinalTopSide: Side = upperFinalWinner ? side(upperFinalWinner.team!, undefined, undefined, noSeeds) : tbd();

const diamondColumns: Column[] = [
  playInRows.length > 0
    ? playIn
    : {
        title: 'Week 1 — Play-In',
        matchups: [
          { a: tbd('Seed 3 — TBD'), b: tbd('Seed 6 — TBD') },
          { a: tbd('Seed 4 — TBD'), b: tbd('Seed 5 — TBD') },
        ],
      },
  round2Rows.length > 0
    ? round2
    : {
        title: 'Week 2',
        matchups: [
          { a: tbd('Seed 1 — TBD'), b: tbd('Play-In Winner — TBD') },
          { a: tbd('Seed 2 — TBD'), b: tbd('Play-In Winner — TBD') },
        ],
      },
  round3Rows.length > 0
    ? round3
    : {
        title: 'Week 3',
        matchups: [
          { a: tbd(), b: tbd() },
          { a: tbd(), b: tbd() },
        ],
      },
  {
    title: 'Week 4 — Lower Bracket Final',
    matchups: round4Rows.length > 0 ? matchupsFromRows(round4Rows, noSeeds) : [{ a: tbd(), b: tbd() }],
  },
  {
    title: 'Week 5 — Grand Final',
    matchups:
      round5Rows.length > 0
        ? matchupsFromRows(round5Rows, noSeeds).map((m) => ({ ...m, grandFinal: true }))
        : [{ a: grandFinalTopSide, b: tbd(), grandFinal: true }],
  },
];

// Emerald: a team dropped, leaving 3 — not enough for double elimination. The 3
// teams play a round robin for 3 weeks (one team on a bye each week) to set the
// playoff standings. Then 2nd vs 3rd in a semifinal, and that winner meets 1st
// in the Grand Final. The round robin matches are listed on the Matchups tab
// like any other week.
//
// The round robin weeks aren't flagged as playoff, so the semifinal is the
// first playoff week and the Grand Final the week after.
const emeraldRows = bracket === 'Emerald' ? getPlayoffMatchupsByBracket('Emerald') : [];
const emeraldSemiWeek = emeraldRows.find((m) => !m.byeWeek)?.week;
const emeraldSemiRows = emeraldRows.filter((m) => m.week === emeraldSemiWeek);
const emeraldFinalRows = emeraldSemiWeek === undefined ? [] : emeraldRows.filter((m) => m.week === emeraldSemiWeek + 1);

// The round robin is the 3 regular-season weeks right before the semifinal.
// Once every one of its matches has a result, its standings seed the
// semifinal and put 1st place into the Grand Final before that row exists.
const emeraldRegularRows =
  emeraldSemiWeek === undefined
    ? []
    : getRegularSeasonMatchupsByBracket('Emerald').filter((m) => m.week < emeraldSemiWeek);
const roundRobinWeeks = [...new Set(emeraldRegularRows.map((m) => m.week))].slice(-3);
const roundRobinRows = emeraldRegularRows.filter((m) => roundRobinWeeks.includes(m.week));
const roundRobinDone =
  roundRobinWeeks.length === 3 &&
  roundRobinRows
    .filter((m) => !m.byeWeek && m.team2)
    .every((m) => {
      const { team1Score, team2Score } = resolveScores(m);
      return team1Score !== undefined && team2Score !== undefined;
    });
const roundRobinStandings = roundRobinDone ? computeStandings(roundRobinRows, { ignoreStatus: true }).main : [];
const emeraldSeedByTeamId = new Map(roundRobinStandings.map((r) => [r.team.teamId, r.tied ? `T-${r.rank}` : String(r.rank)]));
// A tie for 1st is settled by staff, so 1st place stays TBD until it is.
const emeraldFirst = roundRobinStandings.filter((r) => r.rank === 1);
const emeraldFirstSide: Side =
  emeraldFirst.length === 1 ? side(emeraldFirst[0].team, undefined, undefined, emeraldSeedByTeamId) : tbd('1st Place — TBD');

const emeraldColumns: Column[] = [
  {
    title: 'Weeks 1–3 — Round Robin',
    matchups: [],
    matchupsLink: '/tournament/matchups/emerald',
  },
  {
    title: 'Week 4 — Semifinal',
    matchups:
      emeraldSemiRows.length > 0
        ? matchupsFromRows(emeraldSemiRows, emeraldSeedByTeamId)
        : [{ a: tbd('2nd Place — TBD'), b: tbd('3rd Place — TBD') }],
  },
  {
    title: 'Week 5 — Grand Final',
    matchups:
      emeraldFinalRows.length > 0
        ? matchupsFromRows(emeraldFinalRows, emeraldSeedByTeamId).map((m) => ({ ...m, grandFinal: true }))
        : [{ a: emeraldFirstSide, b: tbd('Semifinal Winner — TBD'), grandFinal: true }],
  },
];

const columns = bracket === 'Emerald' ? emeraldColumns : diamondColumns;
const bannerText =
  bracket === 'Emerald'
    ? 'With 3 teams remaining, Emerald playoffs are a 3-week round robin to set the standings. 2nd and 3rd place then play a semifinal, and the winner faces 1st place in the Grand Final.'
    : 'All 8 Diamond teams are seeded together by regular-season record. Seeds 1 & 2 get a bye; seeds 3–6 play in on week 1, and the winners join them in a top 4 double-elimination bracket.';
---

<Layout title={bracket ? `${bracket} Playoffs` : 'Playoffs'}>
  <div class="content-width mx-auto px-8 pb-20 pt-10">
    {!bracket ? (
      <BracketRedirect tab="playoffs" />
    ) : (
      <>
        <TournamentNav activeTab="playoffs" bracket={bracket} />

        <div class="mb-6 rounded-lg border border-gold/20 bg-gold/8 px-4 py-3 text-[13.5px] text-muted">
          {bannerText}
        </div>

        <div
          class="grid grid-cols-1 gap-6 overflow-x-auto pb-2"
          class:list={bracket === 'Diamond' ? 'sm:grid-cols-[repeat(5,minmax(200px,1fr))]' : 'sm:grid-cols-[repeat(3,minmax(200px,1fr))]'}
        >
          {columns.map((col) => (
            <div class="flex flex-col gap-5">
              <div class="font-display text-[13px] font-bold uppercase tracking-wide text-gold">{col.title}</div>
              {col.matchupsLink && (
                <div class="flex flex-col gap-2 rounded-lg border border-gold/18 bg-bg-raised px-4 py-3.5 text-sm text-muted">
                  <span>Round robin matches are played as normal matchups.</span>
                  <a href={col.matchupsLink} class="font-display font-bold text-gold hover:underline">See Matchups →</a>
                </div>
              )}
              {col.matchups.map((m) => (
                <div
                  class:list={[
                    'flex flex-col gap-2 rounded-lg px-4 py-3.5',
                    m.grandFinal
                      ? 'gap-2.5 border-[1.5px] border-gold/40 bg-linear-to-br from-gold/16 to-bg-raised px-[18px] py-[18px]'
                      : 'border border-gold/18 bg-bg-raised',
                  ]}
                >
                  {[m.a, m.b].map((s, i) => (
                    <>
                      {i === 1 && <div class="text-xs text-faint">vs</div>}
                      <div class="flex items-center gap-2.5">
                        {s.team ? (
                          <>
                            {s.team.logoKey ? (
                              <img src={`/media/${s.team.logoKey}`} alt={`${s.team.name} logo`} class="h-9 w-9 shrink-0 rounded-lg object-cover" />
                            ) : (
                              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-linear-to-br from-gold-grad-from to-gold-grad-to font-display text-xs font-bold text-gold-ink">
                                {teamInitials(s.team.name)}
                              </div>
                            )}
                            <div class="flex min-w-0 flex-1 flex-col">
                              <a
                                href={`/teams/${s.team.slug}`}
                                class:list={['break-words font-display text-sm font-bold hover:text-gold', s.won ? 'text-gold' : 'text-ink']}
                              >
                                {s.label}
                              </a>
                              {s.seed && <span class="text-[11px] uppercase tracking-wide text-faint">Seed {s.seed}</span>}
                            </div>
                            {s.score !== undefined && (
                              <span class:list={['font-display text-xl font-bold', s.won ? 'text-gold' : 'text-muted']}>{s.score}</span>
                            )}
                          </>
                        ) : (
                          <div class:list={[m.grandFinal ? 'text-[15px] font-semibold text-ink' : 'text-sm text-muted-softer']}>
                            {s.label}
                          </div>
                        )}
                      </div>
                    </>
                  ))}
                  {m.matchTime && <div class="mt-1 text-xs text-muted-softer">{formatMatchTime(m.matchTime)}</div>}
                </div>
              ))}
            </div>
          ))}
        </div>
      </>
    )}
  </div>
</Layout>
