---
import Layout from '../../../layouts/Layout.astro';
import TournamentNav from '../../../components/TournamentNav.astro';
import BracketRedirect from '../../../components/BracketRedirect.astro';
import { BRACKETS, bracketFromSlug, bracketToSlug } from '../../../lib/brackets';
import { getRegularSeasonMatchupsByBracket, getPlayoffMatchupsByBracket } from '../../../data/matchups';
import { teamInitials } from '../../../data/teams';
import type { Team } from '../../../data/types';
import { computeStandings } from '../../../lib/standings';
import { resolveScores } from '../../../lib/matchScore';
import { formatMatchTime } from '../../../lib/matchTime';

export function getStaticPaths() {
  return [
    // No bracket in the URL (e.g. a homepage quick-access link) — redirect
    // client-side to whichever bracket the visitor last had selected.
    { params: { bracket: undefined } },
    ...BRACKETS.map((b) => ({ params: { bracket: bracketToSlug(b) } })),
  ];
}

const { bracket: bracketSlug } = Astro.params;
const bracket = bracketSlug ? bracketFromSlug(bracketSlug) : undefined;

// One side of a playoff card: either a real team or a placeholder label.
interface Side {
  label: string;
  team?: Team;
  /** Regular-season seed, e.g. "3" or "T-5" when level on every tiebreaker. */
  seed?: string;
  score?: number;
  won?: boolean;
}

interface Matchup {
  a: Side;
  b: Side;
  matchTime?: string;
  grandFinal?: boolean;
}

interface Column {
  title: string;
  matchups: Matchup[];
}

const tbd = (label = 'TBD'): Side => ({ label });

// Emerald: all 4 regular-season teams go straight into a 4-team
// double-elimination bracket. 4 weeks: UB R1, UB Final/LB R1, LB Final, Grand Final.
const emeraldColumns: Column[] = [
  {
    title: 'Week 1',
    matchups: [
      { a: tbd('Seed 1 — TBD'), b: tbd('Seed 4 — TBD') },
      { a: tbd('Seed 2 — TBD'), b: tbd('Seed 3 — TBD') },
    ],
  },
  {
    title: 'Week 2',
    matchups: [
      { a: tbd(), b: tbd() },
      { a: tbd(), b: tbd() },
    ],
  },
  {
    title: 'Week 3 — Lower Bracket Final',
    matchups: [{ a: tbd(), b: tbd() }],
  },
  {
    title: 'Week 4 — Grand Final',
    matchups: [{ a: tbd(), b: tbd(), grandFinal: true }],
  },
];

// Diamond: all 8 teams are ranked together after the regular season. Seeds 1
// and 2 get byes; seeds 3-6 play in on week 1; the two winners join them in a
// 4-team double-elimination bracket for weeks 2-5. Seeds 5 and 6 were level on
// every tiebreaker, so each was drawn against a team from the other group
// (3 vs 6, 4 vs 5) rather than a team they'd already played.
const standings =
  bracket === 'Diamond' ? computeStandings(getRegularSeasonMatchupsByBracket('Diamond')).main : [];
const seedByTeamId = new Map(standings.map((r) => [r.team.teamId, r.tied ? `T-${r.rank}` : String(r.rank)]));

function side(team: Team, score?: number, opponentScore?: number): Side {
  return {
    label: team.name,
    team,
    seed: seedByTeamId.get(team.teamId),
    score,
    won: score !== undefined && opponentScore !== undefined && score > opponentScore,
  };
}

const playoffRows = bracket === 'Diamond' ? getPlayoffMatchupsByBracket('Diamond') : [];
const playInWeek = playoffRows.length > 0 ? Math.min(...playoffRows.map((m) => m.week)) : undefined;
const playInRows = playoffRows.filter((m) => m.week === playInWeek);

const seedNumber = (s: Side) => Number(s.seed?.replace('T-', '') ?? Infinity);

const playIn: Column = {
  title: 'Week 1 — Play-In',
  // Best seed first, so the higher seed's match leads the column.
  matchups: playInRows
    .filter((m) => !m.byeWeek && m.team2)
    .map((m) => {
      const { team1Score, team2Score } = resolveScores(m);
      return {
        a: side(m.team1, team1Score, team2Score),
        b: side(m.team2!, team2Score, team1Score),
        matchTime: m.matchTime,
      };
    })
    .sort((x, y) => Math.min(seedNumber(x.a), seedNumber(x.b)) - Math.min(seedNumber(y.a), seedNumber(y.b))),
};

const diamondColumns: Column[] = [
  playInRows.length > 0
    ? playIn
    : {
        title: 'Week 1 — Play-In',
        matchups: [
          { a: tbd('Seed 3 — TBD'), b: tbd('Seed 6 — TBD') },
          { a: tbd('Seed 4 — TBD'), b: tbd('Seed 5 — TBD') },
        ],
      },
  {
    title: 'Week 2',
    matchups: [
      { a: tbd('Seed 1 — TBD'), b: tbd('Play-In Winner — TBD') },
      { a: tbd('Seed 2 — TBD'), b: tbd('Play-In Winner — TBD') },
    ],
  },
  {
    title: 'Week 3',
    matchups: [
      { a: tbd(), b: tbd() },
      { a: tbd(), b: tbd() },
    ],
  },
  {
    title: 'Week 4 — Lower Bracket Final',
    matchups: [{ a: tbd(), b: tbd() }],
  },
  {
    title: 'Week 5 — Grand Final',
    matchups: [{ a: tbd(), b: tbd(), grandFinal: true }],
  },
];

const columns = bracket === 'Emerald' ? emeraldColumns : diamondColumns;
const bannerText =
  bracket === 'Emerald'
    ? 'Top 4 double-elimination. Seeds populate once the Emerald regular season concludes.'
    : 'All 8 Diamond teams are seeded together by regular-season record. Seeds 1 & 2 get a bye; seeds 3–6 play in on week 1, and the winners join them in a top 4 double-elimination bracket.';
---

<Layout title={bracket ? `${bracket} Playoffs` : 'Playoffs'}>
  <div class="content-width mx-auto px-8 pb-20 pt-10">
    {!bracket ? (
      <BracketRedirect tab="playoffs" />
    ) : (
      <>
        <TournamentNav activeTab="playoffs" bracket={bracket} />

        <div class="mb-6 rounded-lg border border-gold/20 bg-gold/8 px-4 py-3 text-[13.5px] text-muted">
          {bannerText}
        </div>

        <div
          class="grid grid-cols-1 gap-6 overflow-x-auto pb-2"
          class:list={bracket === 'Diamond' ? 'sm:grid-cols-[repeat(5,minmax(200px,1fr))]' : 'sm:grid-cols-[repeat(4,minmax(200px,1fr))]'}
        >
          {columns.map((col) => (
            <div class="flex flex-col gap-5">
              <div class="font-display text-[13px] font-bold uppercase tracking-wide text-gold">{col.title}</div>
              {col.matchups.map((m) => (
                <div
                  class:list={[
                    'flex flex-col gap-2 rounded-lg px-4 py-3.5',
                    m.grandFinal
                      ? 'gap-2.5 border-[1.5px] border-gold/40 bg-linear-to-br from-gold/16 to-bg-raised px-[18px] py-[18px]'
                      : 'border border-gold/18 bg-bg-raised',
                  ]}
                >
                  {[m.a, m.b].map((s, i) => (
                    <>
                      {i === 1 && <div class="text-xs text-faint">vs</div>}
                      <div class="flex items-center gap-2.5">
                        {s.team ? (
                          <>
                            {s.team.logoKey ? (
                              <img src={`/media/${s.team.logoKey}`} alt={`${s.team.name} logo`} class="h-9 w-9 shrink-0 rounded-lg object-cover" />
                            ) : (
                              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-linear-to-br from-gold-grad-from to-gold-grad-to font-display text-xs font-bold text-gold-ink">
                                {teamInitials(s.team.name)}
                              </div>
                            )}
                            <div class="flex min-w-0 flex-1 flex-col">
                              <a
                                href={`/teams/${s.team.slug}`}
                                class:list={['break-words font-display text-sm font-bold hover:text-gold', s.won ? 'text-gold' : 'text-ink']}
                              >
                                {s.label}
                              </a>
                              {s.seed && <span class="text-[11px] uppercase tracking-wide text-faint">Seed {s.seed}</span>}
                            </div>
                            {s.score !== undefined && (
                              <span class:list={['font-display text-xl font-bold', s.won ? 'text-gold' : 'text-muted']}>{s.score}</span>
                            )}
                          </>
                        ) : (
                          <div class:list={[m.grandFinal ? 'text-[15px] font-semibold text-ink' : 'text-sm text-muted-softer']}>
                            {s.label}
                          </div>
                        )}
                      </div>
                    </>
                  ))}
                  {m.matchTime && <div class="mt-1 text-xs text-muted-softer">{formatMatchTime(m.matchTime)}</div>}
                </div>
              ))}
            </div>
          ))}
        </div>
      </>
    )}
  </div>
</Layout>
