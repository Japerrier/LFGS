---
import Layout from '../../layouts/Layout.astro';
import { teams, teamInitials } from '../../data/teams';
import { getMembersByTeamId, memberRoles } from '../../data/team-members';
import { bracketToSlug } from '../../lib/brackets';
import { slugify } from '../../lib/slug';
import { CURRENT_LFGS_SEASON } from '../../lib/season';
import { displayRank } from '../../lib/rank';
import { getMatchupsByTeamId } from '../../data/matchups';
import { resolveScores } from '../../lib/matchScore';

export async function getStaticPaths() {
  return Promise.all(
    teams.map(async (t) => ({
      params: { slug: t.slug },
      props: { team: t, members: await getMembersByTeamId(t.teamId) },
    }))
  );
}

const { team, members } = Astro.props;
const roster = members.filter((m) => m.memberType === 'Player');
const headCoach = members.find((m) => m.memberType === 'Head Coach');
const assistantCoach = members.find((m) => m.memberType === 'Assistant Coach');
const captain = roster.find((m) => m.captain);

// Only matches that have a result (a score, or a forfeit that implies one),
// shown from this team's point of view.
const matchHistory = getMatchupsByTeamId(team.teamId)
  .map((m) => {
    const isTeam1 = m.team1.teamId === team.teamId;
    const { team1Score, team2Score } = resolveScores(m);
    if (team1Score === undefined || team2Score === undefined) return undefined;
    const teamScore = isTeam1 ? team1Score : team2Score;
    const opponentScore = isTeam1 ? team2Score : team1Score;
    const teamForfeited = isTeam1 ? m.team1Forfeit : m.team2Forfeit;
    const opponentForfeited = isTeam1 ? m.team2Forfeit : m.team1Forfeit;
    // Worded from this team's point of view so it can't be misread as the opponent's forfeit.
    const forfeitLabel =
      teamForfeited && opponentForfeited
        ? 'Double forfeit'
        : teamForfeited
          ? 'Forfeit loss'
          : opponentForfeited
            ? 'Forfeit win'
            : undefined;
    return {
      matchId: m.matchId,
      week: m.week,
      opponent: isTeam1 ? m.team2 : m.team1,
      teamScore,
      opponentScore,
      won: teamScore > opponentScore,
      forfeitLabel,
    };
  })
  .filter((m) => m !== undefined);

const rosterWithRank = roster.map((p) => ({
  member: p,
  rank: displayRank(
    { tank: p.peakRankTank, dps: p.peakRankDPS, support: p.peakRankSupport },
    {
      tank: Boolean(p.registeredForTank),
      dps: Boolean(p.registeredForDps),
      support: Boolean(p.registeredForSupport),
    }
  ),
}));
---

<Layout title={team.name}>
  <div class="content-width mx-auto px-8 pb-20 pt-8">
    <a
      href={`/tournament/teams/${bracketToSlug(team.bracket)}`}
      class="mb-5 inline-flex items-center gap-1.5 text-[13.5px] text-muted"
    >
      ← All Teams
    </a>

    <div class="mb-8 flex items-center gap-6 rounded-2xl border border-gold/18 bg-bg-raised p-9">
      {team.logoKey ? (
        <img src={`/media/${team.logoKey}`} alt={`${team.name} logo`} class="h-24 w-24 shrink-0 rounded-2xl object-cover" />
      ) : (
        <div class="flex h-24 w-24 shrink-0 items-center justify-center rounded-2xl bg-linear-to-br from-gold-grad-from to-gold-grad-to font-display text-2xl font-bold text-gold-ink">
          {teamInitials(team.name)}
        </div>
      )}
      <div class="flex-1">
        <div class="mb-1.5 flex items-center gap-2.5">
          <div class="rounded-md bg-gold/12 px-2.5 py-[3px] font-display text-xs font-semibold uppercase tracking-wide text-gold">
            {team.bracket}
          </div>
        </div>
        <div class="font-display text-[34px] font-bold text-ink">{team.name}</div>
      </div>
      {team.teamRank && (
        <div class="flex flex-col items-end gap-1.5">
          <div class="font-display text-xs font-semibold uppercase tracking-wide text-muted">Team Average</div>
          <div class="rounded-md bg-gold/12 px-2.5 py-[3px] font-display text-xs font-semibold uppercase tracking-wide text-gold">
            {team.teamRank}
          </div>
        </div>
      )}
    </div>

    <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-[2fr_1fr]">
      <div>
        <h2 class="mb-4 font-display text-xl font-bold text-ink">Roster</h2>
        {roster.length === 0 ? (
          <div class="mb-8 rounded-xl border border-gold/12 bg-bg-raised p-6 text-sm text-muted">
            Rosters haven't been added for Season {CURRENT_LFGS_SEASON} yet — check back soon.
          </div>
        ) : (
          <div class="mb-8 grid grid-cols-1 gap-3.5 sm:grid-cols-2">
            {rosterWithRank.map(({ member: p, rank }) => (
              <a href={`/teams/${team.slug}/players/${slugify(p.name)}`} class="overflow-hidden rounded-xl border border-gold/12 bg-bg-raised">
                {p.profileImageKey && (
                  <img src={`/media/${p.profileImageKey}`} alt={`${p.name} profile`} class="h-30 w-full object-cover" />
                )}
                <div class="p-3.5">
                  <div class="mb-2 flex items-center gap-1.5">
                    <div class="font-display text-base font-bold text-ink">{p.name}</div>
                    {p.captain && <span class="text-[13px] text-gold">★</span>}
                  </div>
                  <div class="flex flex-wrap items-center justify-between gap-1.5">
                    <div class="flex flex-wrap gap-1.5">
                      {memberRoles(p).map((r) => (
                        <span class="rounded-full bg-gold/10 px-2.5 py-[3px] text-[11px] font-semibold text-gold">{r}</span>
                      ))}
                    </div>
                    {rank && (
                      <span class="rounded-full bg-gold/10 px-2.5 py-[3px] text-[11px] font-semibold text-gold">{rank}</span>
                    )}
                  </div>
                </div>
              </a>
            ))}
          </div>
        )}

        <h2 class="mb-4 font-display text-xl font-bold text-ink">Match History</h2>
        {matchHistory.length === 0 ? (
          <div class="rounded-xl border border-gold/12 bg-bg-raised p-6 text-sm text-muted">
            Season {CURRENT_LFGS_SEASON} hasn't started yet — match history will appear here after Week 1.
          </div>
        ) : (
          <div class="overflow-hidden rounded-xl border border-gold/12 bg-bg-raised">
            <div class="grid grid-cols-[72px_1fr_auto] gap-4 border-b border-gold/12 px-5 py-3 font-display text-xs font-semibold uppercase tracking-wide text-muted">
              <div>Week</div>
              <div>Opponent</div>
              <div class="text-right">Score</div>
            </div>
            {matchHistory.map((m) => (
              <div class="grid grid-cols-[72px_1fr_auto] items-center gap-4 border-b border-gold/8 px-5 py-3.5 last:border-b-0">
                <div class="font-display text-sm font-bold text-muted-softer">{m.week}</div>
                <a href={`/teams/${m.opponent.slug}`} class="flex min-w-0 items-center gap-3 font-display text-[15px] font-bold text-ink hover:text-gold">
                  {m.opponent.logoKey ? (
                    <img src={`/media/${m.opponent.logoKey}`} alt={`${m.opponent.name} logo`} class="h-9 w-9 shrink-0 rounded-lg object-cover" />
                  ) : (
                    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-linear-to-br from-gold-grad-from to-gold-grad-to font-display text-xs font-bold text-gold-ink">
                      {teamInitials(m.opponent.name)}
                    </div>
                  )}
                  <span class="truncate">{m.opponent.name}</span>
                </a>
                <div class="flex items-center justify-end gap-3">
                  {m.forfeitLabel && (
                    <span class="rounded-full border border-youtube/40 px-2 py-0.5 text-[11px] font-bold uppercase tracking-wide text-youtube">
                      {m.forfeitLabel}
                    </span>
                  )}
                  <div class:list={['font-display text-lg font-bold', m.won ? 'text-gold' : 'text-muted']}>
                    {m.teamScore} – {m.opponentScore}
                  </div>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      <div class="mt-11 flex flex-col gap-4">
        <div class="rounded-xl border border-gold/12 bg-bg-raised p-5">
          <div class="flex flex-col gap-3">
            {headCoach && (
              <div>
                <div class="font-display text-[15px] font-bold text-ink-bright">Head Coach</div>
                <div class="text-sm text-muted-softer">{headCoach.name}</div>
              </div>
            )}
            {assistantCoach && (
              <div>
                <div class="font-display text-[15px] font-bold text-ink-bright">Assistant Coach</div>
                <div class="text-sm text-muted-softer">{assistantCoach.name}</div>
              </div>
            )}
            <div>
              <div class="font-display text-[15px] font-bold text-ink-bright">Captain</div>
              <div class="text-sm text-muted-softer">{captain?.name ?? 'TBD'}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
