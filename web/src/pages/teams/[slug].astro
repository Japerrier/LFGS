---
import Layout from '../../layouts/Layout.astro';
import { teams } from '../../data/teams';
import { bracketToSlug } from '../../lib/brackets';

export function getStaticPaths() {
  return teams.map((t) => ({ params: { slug: t.slug }, props: { team: t } }));
}

const { team } = Astro.props;
---

<Layout title={team.name}>
  <div class="mx-auto max-w-5xl px-8 pb-20 pt-8">
    <a
      href={`/tournament/teams/${bracketToSlug(team.bracket)}`}
      class="mb-5 inline-flex items-center gap-1.5 text-[13.5px] text-muted"
    >
      ← All Teams
    </a>

    <div
      class="mb-8 flex items-center gap-6 rounded-2xl border p-9"
      style={`background:linear-gradient(120deg,${team.primaryColor}33,${team.secondaryColor}22),#141317;border-color:${team.primaryColor}55`}
    >
      <div
        class="flex h-24 w-24 shrink-0 items-center justify-center rounded-2xl font-display text-[34px] font-bold text-bg"
        style={`background:linear-gradient(135deg,${team.primaryColor},${team.secondaryColor})`}
      >
        {team.initials}
      </div>
      <div class="flex-1">
        <div class="mb-1.5 flex items-center gap-2.5">
          <div class="rounded-md bg-gold/12 px-2.5 py-[3px] font-display text-xs font-semibold uppercase tracking-wide text-gold">
            {team.bracket}
          </div>
        </div>
        <div class="font-display text-[34px] font-bold text-ink">{team.name}</div>
      </div>
      <div class="text-right">
        <div class="font-display text-[26px] font-bold text-ink">{team.record}</div>
        <div class="text-xs uppercase tracking-wide text-muted">Record</div>
      </div>
    </div>

    <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-[2fr_1fr]">
      <div>
        <h2 class="mb-4 font-display text-xl font-bold text-ink">Roster</h2>
        <div class="mb-8 grid grid-cols-1 gap-3.5 sm:grid-cols-2">
          {team.players.map((p) => (
            <a
              href={`/teams/${team.slug}/players/${p.id}`}
              class="overflow-hidden rounded-xl border border-gold/12 bg-bg-raised"
            >
              <div class="flex h-30 items-center justify-center bg-[repeating-linear-gradient(45deg,#1c1b20,#1c1b20_10px,#201f24_10px,#201f24_20px)] text-center font-mono text-[11px] text-faint">
                Account banner screenshot
              </div>
              <div class="p-3.5">
                <div class="mb-1 flex items-center gap-1.5">
                  <div class="font-display text-base font-bold text-ink">{p.name}</div>
                  {p.captain && <span class="text-[13px] text-gold">★</span>}
                </div>
                <div class="mb-2 text-xs text-muted">{p.ign}</div>
                <div class="flex flex-wrap gap-1.5">
                  {p.roles.map((r) => (
                    <span class="rounded-full bg-gold/10 px-2.5 py-[3px] text-[11px] font-semibold text-gold">{r}</span>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>

        <h2 class="mb-4 font-display text-xl font-bold text-ink">Match History</h2>
        <div class="rounded-xl border border-gold/12 bg-bg-raised p-6 text-sm text-muted">
          Season 8 hasn't started yet — match history will appear here after Week 1.
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <div class="rounded-xl border border-gold/12 bg-bg-raised p-5">
          <div class="mb-3.5 font-display text-[15px] font-bold text-ink">Staff</div>
          <div class="flex flex-col gap-3">
            <div>
              <div class="text-sm font-semibold text-ink">{team.coach}</div>
              <div class="text-[11.5px] uppercase tracking-wide text-muted">Coach</div>
            </div>
            <div>
              <div class="text-sm font-semibold text-ink">{team.manager}</div>
              <div class="text-[11.5px] uppercase tracking-wide text-muted">Manager</div>
            </div>
          </div>
        </div>

        <div class="rounded-xl border border-gold/12 bg-bg-raised p-5">
          <div class="mb-3.5 font-display text-[15px] font-bold text-ink">Standings</div>
          <div class="mb-2 flex justify-between text-[13.5px] text-muted-softer">
            <span>Bracket</span>
            <span class="font-semibold text-ink">{team.bracket}</span>
          </div>
          <div class="flex justify-between text-[13.5px] text-muted-softer">
            <span>Record</span>
            <span class="font-semibold text-ink">{team.record}</span>
          </div>
        </div>

        {team.socials.length > 0 && (
          <div class="rounded-xl border border-gold/12 bg-bg-raised p-5">
            <div class="mb-3 font-display text-[15px] font-bold text-ink">Socials</div>
            <div class="flex flex-col gap-2">
              {team.socials.map((s) => (
                <a href={s.url} target="_blank" rel="noopener noreferrer" class="text-[13.5px]">
                  {s.label}
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</Layout>
