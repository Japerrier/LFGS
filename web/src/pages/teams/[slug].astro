---
import Layout from '../../layouts/Layout.astro';
import { teams, teamInitials } from '../../data/teams';
import { getMembersByTeamId, memberRoles } from '../../data/team-members';
import { bracketToSlug } from '../../lib/brackets';
import { slugify } from '../../lib/slug';

export async function getStaticPaths() {
  return Promise.all(
    teams.map(async (t) => ({
      params: { slug: t.slug },
      props: { team: t, members: await getMembersByTeamId(t.teamId) },
    }))
  );
}

const { team, members } = Astro.props;
const roster = members.filter((m) => m.memberType === 'Player');
const headCoach = members.find((m) => m.memberType === 'Head Coach');
const assistantCoach = members.find((m) => m.memberType === 'Assistant Coach');
const captain = roster.find((m) => m.captain);
---

<Layout title={team.name}>
  <div class="mx-auto max-w-5xl px-8 pb-20 pt-8">
    <a
      href={`/tournament/teams/${bracketToSlug(team.bracket)}`}
      class="mb-5 inline-flex items-center gap-1.5 text-[13.5px] text-muted"
    >
      ← All Teams
    </a>

    <div class="mb-8 flex items-center gap-6 rounded-2xl border border-gold/18 bg-bg-raised p-9">
      {team.logoKey ? (
        <img src={`/media/${team.logoKey}`} alt={`${team.name} logo`} class="h-24 w-24 shrink-0 rounded-2xl object-cover" />
      ) : (
        <div class="flex h-24 w-24 shrink-0 items-center justify-center rounded-2xl bg-linear-to-br from-gold-grad-from to-gold-grad-to font-display text-2xl font-bold text-gold-ink">
          {teamInitials(team.name)}
        </div>
      )}
      <div class="flex-1">
        <div class="mb-1.5 flex items-center gap-2.5">
          <div class="rounded-md bg-gold/12 px-2.5 py-[3px] font-display text-xs font-semibold uppercase tracking-wide text-gold">
            {team.bracket}
          </div>
        </div>
        <div class="font-display text-[34px] font-bold text-ink">{team.name}</div>
      </div>
    </div>

    <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-[2fr_1fr]">
      <div>
        <h2 class="mb-4 font-display text-xl font-bold text-ink">Roster</h2>
        {roster.length === 0 ? (
          <div class="mb-8 rounded-xl border border-gold/12 bg-bg-raised p-6 text-sm text-muted">
            Rosters haven't been added for Season 8 yet — check back soon.
          </div>
        ) : (
          <div class="mb-8 grid grid-cols-1 gap-3.5 sm:grid-cols-2">
            {roster.map((p) => (
              <a href={`/teams/${team.slug}/players/${slugify(p.name)}`} class="overflow-hidden rounded-xl border border-gold/12 bg-bg-raised">
                {p.profileImageKey ? (
                  <img src={`/media/${p.profileImageKey}`} alt={`${p.name} profile`} class="h-30 w-full object-cover" />
                ) : (
                  <div class="flex h-30 items-center justify-center bg-[repeating-linear-gradient(45deg,#1c1b20,#1c1b20_10px,#201f24_10px,#201f24_20px)] text-center font-mono text-[11px] text-faint">
                    profile
                  </div>
                )}
                <div class="p-3.5">
                  <div class="mb-2 flex items-center gap-1.5">
                    <div class="font-display text-base font-bold text-ink">{p.name}</div>
                    {p.captain && <span class="text-[13px] text-gold">★</span>}
                  </div>
                  <div class="flex flex-wrap gap-1.5">
                    {memberRoles(p).map((r) => (
                      <span class="rounded-full bg-gold/10 px-2.5 py-[3px] text-[11px] font-semibold text-gold">{r}</span>
                    ))}
                  </div>
                </div>
              </a>
            ))}
          </div>
        )}

        <h2 class="mb-4 font-display text-xl font-bold text-ink">Match History</h2>
        <div class="rounded-xl border border-gold/12 bg-bg-raised p-6 text-sm text-muted">
          Season 8 hasn't started yet — match history will appear here after Week 1.
        </div>
      </div>

      <div class="mt-11 flex flex-col gap-4">
        <div class="rounded-xl border border-gold/12 bg-bg-raised p-5">
          <div class="flex flex-col gap-3">
            {headCoach && (
              <div>
                <div class="font-display text-[15px] font-bold text-ink-bright">Head Coach</div>
                <div class="text-sm text-muted-softer">{headCoach.name}</div>
              </div>
            )}
            {assistantCoach && (
              <div>
                <div class="font-display text-[15px] font-bold text-ink-bright">Assistant Coach</div>
                <div class="text-sm text-muted-softer">{assistantCoach.name}</div>
              </div>
            )}
            <div>
              <div class="font-display text-[15px] font-bold text-ink-bright">Captain</div>
              <div class="text-sm text-muted-softer">{captain?.name ?? 'TBD'}</div>
            </div>
          </div>
        </div>

        <div class="rounded-xl border border-gold/12 bg-bg-raised p-5">
          <div class="mb-3.5 font-display text-[15px] font-bold text-ink">Standings</div>
          <div class="text-[13.5px] text-muted-softer">Standings will be available after Week 1.</div>
        </div>
      </div>
    </div>
  </div>
</Layout>
