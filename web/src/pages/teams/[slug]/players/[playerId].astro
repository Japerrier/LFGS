---
import Layout from '../../../../layouts/Layout.astro';
import { teams } from '../../../../data/teams';

export function getStaticPaths() {
  return teams.flatMap((team) =>
    team.players.map((player) => ({
      params: { slug: team.slug, playerId: player.id },
      props: { team, player },
    }))
  );
}

const { team, player } = Astro.props;
---

<Layout title={`${player.name} — ${team.name}`}>
  <div class="mx-auto max-w-3xl px-8 pb-20 pt-8">
    <a href={`/teams/${team.slug}`} class="mb-5 inline-flex items-center gap-1.5 text-[13.5px] text-muted">
      ← Back to {team.name}
    </a>

    <div class="mb-7 flex items-center gap-4.5">
      <div
        class="flex h-16 w-16 items-center justify-center rounded-xl font-display text-[22px] font-bold text-bg"
        style={`background:linear-gradient(135deg,${team.primaryColor},${team.secondaryColor})`}
      >
        {team.initials}
      </div>
      <div>
        <div class="flex items-center gap-2">
          <div class="font-display text-[28px] font-bold text-ink">{player.name}</div>
          {player.captain && <span class="text-lg text-gold">★</span>}
        </div>
        <div class="text-[13.5px] text-muted">{player.ign} · {team.name}</div>
      </div>
    </div>

    <div class="mb-7 flex flex-wrap gap-1.5">
      {player.roles.map((r) => (
        <span class="rounded-full bg-gold/10 px-3 py-1 text-xs font-semibold text-gold">{r}</span>
      ))}
    </div>

    <h2 class="mb-1.5 font-display text-lg font-bold text-ink">Account Banner</h2>
    <p class="mb-3.5 text-[13px] text-muted">Screenshot of the player's in-game account/career profile banner.</p>
    <div class="mb-8 flex h-35 items-center justify-center rounded-xl border border-gold/12 bg-[repeating-linear-gradient(45deg,#1c1b20,#1c1b20_10px,#201f24_10px,#201f24_20px)] font-mono text-xs text-faint">
      Account banner screenshot
    </div>

    <h2 class="mb-1.5 font-display text-lg font-bold text-ink">Sign-up Qualification</h2>
    <p class="mb-3.5 text-[13px] text-muted">Screenshots submitted at registration to verify rank/tier eligibility.</p>
    <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2">
      <div class="flex h-30 items-center justify-center rounded-[10px] border border-gold/12 bg-[repeating-linear-gradient(45deg,#1c1b20,#1c1b20_10px,#201f24_10px,#201f24_20px)] text-center font-mono text-[11px] text-faint">
        Rank qualification screenshot
      </div>
      <div class="flex h-30 items-center justify-center rounded-[10px] border border-gold/12 bg-[repeating-linear-gradient(45deg,#1c1b20,#1c1b20_10px,#201f24_10px,#201f24_20px)] text-center font-mono text-[11px] text-faint">
        Season stats screenshot
      </div>
    </div>
  </div>
</Layout>
