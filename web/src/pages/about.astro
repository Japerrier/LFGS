---
import Layout from '../layouts/Layout.astro';
import { leadership, externalLinks } from '../data/site';

const coreLeadership = leadership.filter((ld) => ld.role !== 'Staff');
const staffLeadership = leadership.filter((ld) => ld.role === 'Staff');
---

<Layout title="About">
  <!-- HERO -->
  <section class="relative flex h-[420px] flex-col items-center justify-center overflow-hidden border-b border-gold/15 text-center">
    <div
      class="absolute inset-0 bg-cover bg-[center_30%] brightness-[0.42]"
      style="background-image:url('/images/hero-characters.png')"
    >
    </div>
    <div class="absolute inset-0 bg-linear-to-b from-bg/35 to-bg"></div>
    <div class="relative z-2 px-6">
      <h1 class="font-display text-[52px] font-bold text-ink-bright">WHAT IS LFGS?</h1>
      <p class="mx-auto mt-3.5 max-w-[600px] text-[17px] leading-relaxed text-muted-softer">
        A community-run Overwatch scrim &amp; tournament server — Looking For Gold Scrims. Real competition, run
        by players, for players.
      </p>
    </div>
  </section>

  <!-- BUILT ON DISCORD -->
  <section class="content-width mx-auto grid grid-cols-1 items-center gap-12 px-8 py-18 lg:grid-cols-[1.1fr_1fr]">
    <div>
      <div class="mb-2.5 font-display text-[13px] font-semibold uppercase tracking-[2.5px] text-gold">
        Built on Discord
      </div>
      <h2 class="mb-3.5 font-display text-3xl font-bold leading-tight text-ink">
        Metal rank players, meet your match.
      </h2>
      <p class="mb-[22px] text-[15px] leading-relaxed text-muted-soft">
        Scrim finding, weekly matchups, results, and an ever growing community — it's all coordinated live in our
        Discord. Come join the fun.
      </p>
      <a
        href={externalLinks.discord}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block rounded-lg bg-linear-to-br from-gold-grad-from to-gold-grad-to px-7 py-3.5 font-display text-base font-bold text-gold-ink"
      >
        Join discord.gg/lfgs →
      </a>
    </div>
    <div class="flex flex-col gap-3.5 rounded-2xl border border-[#5865f2]/25 bg-bg-raised p-7">
      <div class="font-display text-[15px] font-bold text-ink">In the server</div>
      <div class="flex gap-2.5 text-[13.5px] text-muted-soft"><span class="text-gold">—</span> Dedicated tournament channels</div>    
      <div class="flex gap-2.5 text-[13.5px] text-muted-soft"><span class="text-gold">—</span> Looking for team &amp; player channels</div>
      <div class="flex gap-2.5 text-[13.5px] text-muted-soft"><span class="text-gold">—</span> Metal rank scrim finder</div>
      <div class="flex gap-2.5 text-[13.5px] text-muted-soft"><span class="text-gold">—</span> High rank scrim finder</div>
    </div>
  </section>

  <!-- LEADERSHIP -->
  <section class="content-width mx-auto px-8 pt-15">
    <div class="mb-7 text-center">
      <h2 class="mb-1.5 font-display text-[26px] font-bold text-ink">LFGS Leadership</h2>
      <p class="text-sm text-muted">The owner, mods, and staff keeping the server running</p>
    </div>
    <div class="mb-4 grid grid-cols-2 gap-4 sm:grid-cols-4">
      {coreLeadership.map((ld) => (
        <div class="flex flex-col items-center gap-3 rounded-[14px] border border-gold/14 bg-bg-raised px-[14px] py-6">
          <img src={ld.photo} alt={ld.name} class="h-[77px] w-[77px] rounded-full object-cover object-center" />
          <div class="text-center font-display text-[18px] font-bold text-ink">{ld.name}</div>
          <div class="text-center text-[13px] font-semibold uppercase tracking-wide text-gold">{ld.role}</div>
        </div>
      ))}
    </div>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-6">
      {staffLeadership.map((ld) => (
        <div class="flex flex-col items-center gap-3 rounded-[14px] border border-gold/14 bg-bg-raised px-[14px] py-6">
          <img src={ld.photo} alt={ld.name} class="h-[77px] w-[77px] rounded-full object-cover object-center" />
          <div class="text-center font-display text-[18px] font-bold text-ink">{ld.name}</div>
          <div class="text-center text-[13px] font-semibold uppercase tracking-wide text-gold">{ld.role}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- WATCH LIVE & CATCH VODS -->
  <section class="mt-15 border-y border-gold/12 bg-bg-strip px-8 py-15">
    <div class="content-width mx-auto">
      <h2 class="mb-9 text-center font-display text-[26px] font-bold text-ink">Watch Live &amp; Catch VODs</h2>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <a
          href={externalLinks.twitch}
          target="_blank"
          rel="noopener noreferrer"
          class="block rounded-2xl border border-twitch/30 bg-linear-to-br from-twitch/14 to-[#1a191e] p-7"
        >
          <div class="mb-1.5 font-display text-lg font-bold text-ink">Twitch — Live Matches</div>
          <div class="mb-3 text-[13.5px] text-muted-soft">We stream scrim nights and playoffs live.</div>
          <div class="text-[13px] font-semibold text-twitch">twitch.tv/lookingforgoldscrims →</div>
        </a>
        <a
          href={externalLinks.youtube}
          target="_blank"
          rel="noopener noreferrer"
          class="block rounded-2xl border border-youtube/28 bg-linear-to-br from-youtube/12 to-[#1a191e] p-7"
        >
          <div class="mb-1.5 font-display text-lg font-bold text-ink">YouTube — VODs &amp; Montages</div>
          <div class="mb-3 text-[13.5px] text-muted-soft">Full match uploads after they wrap, plus season montage videos.</div>
          <div class="text-[13px] font-semibold text-youtube">youtube.com/@lfgs7475 →</div>
        </a>
      </div>
      <!-- TODO: latest montage embed goes here once Season 8 wraps -->
    </div>
  </section>

  <!-- CLOSING CTA -->
  <section class="mx-auto max-w-3xl px-8 py-18 text-center">
    <h2 class="mb-4 font-display text-3xl font-bold text-ink">Ready to compete in Season 8?</h2>
    <p class="mb-6.5 text-[15px] text-muted-soft">Diamond &amp; Platinum sign-ups are open now. Bring your squad.</p>
    <a
      href="/tournament/register"
      class="inline-block rounded-lg bg-linear-to-br from-gold-grad-from to-gold-grad-to px-8 py-[15px] font-display text-[17px] font-bold text-gold-ink"
    >
      Register for Season 8
    </a>
  </section>
</Layout>
