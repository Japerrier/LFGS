---
import { teamInitials } from '../data/teams';
import type { StandingsRow } from '../lib/standings';

interface Props {
  rows: StandingsRow[];
  /** The separate table for withdrawn/disqualified teams: no rank numbers or
   *  tie markers, and each team is labeled with its status instead. */
  unranked?: boolean;
}

const { rows, unranked = false } = Astro.props;

const columns = 'grid-cols-[32px_1fr_repeat(4,40px)_48px] sm:grid-cols-[48px_1fr_repeat(4,56px)_64px]';
---

<div class="overflow-hidden rounded-xl border border-gold/12 bg-bg-raised">
  <div
    class:list={[
      'grid gap-2 border-b border-gold/12 px-4 py-4 font-display text-sm font-semibold uppercase tracking-wide text-muted sm:gap-3 sm:px-6',
      columns,
    ]}
  >
    <div>#</div>
    <div>Team</div>
    <div class="text-center" title="Match wins">W</div>
    <div class="text-center" title="Match losses">L</div>
    <div class="text-center" title="Map wins">MW</div>
    <div class="text-center" title="Map losses">ML</div>
    <div class="text-center" title="Map differential: map wins minus map losses, the third tiebreaker">MD</div>
  </div>
  {rows.map((row, i) => (
    <>
    {/* Eliminated teams are sorted below the teams still in; a labeled rule marks where. */}
    {!unranked && row.team.status === 'eliminated' && i > 0 && rows[i - 1].team.status !== 'eliminated' && (
      <div class="flex items-center gap-3 border-b border-gold/8 bg-bg px-4 py-2 sm:px-6">
        <div class="h-px flex-1 bg-gold/40"></div>
        <span class="font-display text-[11px] font-semibold uppercase tracking-widest text-muted">Eliminated</span>
        <div class="h-px flex-1 bg-gold/40"></div>
      </div>
    )}
    <div
      class:list={[
        'grid items-center gap-2 border-b border-gold/8 px-4 py-4 last:border-b-0 sm:gap-3 sm:px-6',
        columns,
      ]}
    >
      <div class="font-display text-xl font-bold text-muted-softer">
        {unranked ? '–' : <>{row.rank}{row.tied && <span class="text-gold">*</span>}</>}
      </div>
      <a href={`/teams/${row.team.slug}`} class="flex min-w-0 items-center gap-4 font-display text-[19px] font-bold text-ink hover:text-gold">
        {row.team.logoKey ? (
          <img src={`/media/${row.team.logoKey}`} alt={`${row.team.name} logo`} class="h-14 w-14 shrink-0 rounded-xl object-cover" />
        ) : (
          <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-linear-to-br from-gold-grad-from to-gold-grad-to font-display text-lg font-bold text-gold-ink">
            {teamInitials(row.team.name)}
          </div>
        )}
        <span class="flex min-w-0 flex-col items-start gap-1 leading-tight">
          {row.team.name}
          {unranked && row.team.status && (
            <span class="rounded-full border border-youtube/40 px-2 py-0.5 text-[11px] font-bold uppercase tracking-wide text-youtube">
              {row.team.status}
            </span>
          )}
        </span>
      </a>
      <div class="text-center font-display text-2xl font-bold text-gold">{row.wins}</div>
      <div class="text-center font-display text-2xl font-bold text-ink">{row.losses}</div>
      <div class="text-center text-lg text-muted-softer">{row.mapWins}</div>
      <div class="text-center text-lg text-muted-softer">{row.mapLosses}</div>
      <div class="text-center text-lg text-muted">{row.mapDiff > 0 ? `+${row.mapDiff}` : row.mapDiff}</div>
    </div>
    </>
  ))}
</div>
