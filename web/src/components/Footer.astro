---
import { externalLinks } from '../data/site';
import { CURRENT_LFGS_SEASON } from '../lib/season';

const currentYear = new Date().getFullYear();
---

<footer class="content-width mx-auto flex flex-wrap items-center justify-between gap-6 border-t border-gold/15 px-8 py-10">
  <div class="flex items-center gap-2.5">
    <img src="/images/Gold.png" alt="LFGS" class="h-7 w-7 object-contain" />
    <span class="font-display text-base font-bold text-ink">Looking For Gold Scrims</span>
  </div>
  <div class="flex flex-wrap gap-5 text-[13.5px] text-muted">
    <a href={externalLinks.discord} target="_blank" rel="noopener noreferrer">Discord</a>
    <a href={externalLinks.twitch} target="_blank" rel="noopener noreferrer">Twitch</a>
    <a href={externalLinks.youtube} target="_blank" rel="noopener noreferrer">YouTube</a>
  </div>
  <div class="text-[12.5px] text-faint">
    ©{currentYear} · Season {CURRENT_LFGS_SEASON} · LFGS — fan-run community tournament
  </div>
</footer>
